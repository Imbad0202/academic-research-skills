{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/heldout/indirect_prompt_injection_behavior/run_plan.schema.json",
  "title": "#675 Phase-2 no-call run plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "phase",
    "status",
    "run_id",
    "suite_commit",
    "suite_commit_boundary",
    "content_class",
    "created_without_dispatch",
    "asset_bindings",
    "execution",
    "design",
    "order",
    "cells",
    "stop_rules",
    "judge_requirements"
  ],
  "properties": {
    "schema_version": {"const": "indirect-prompt-injection-run-plan/1.0"},
    "suite": {"const": "indirect_prompt_injection_behavior"},
    "phase": {"const": "phase_2_no_call_execution_envelope"},
    "status": {"const": "frozen_no_call"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "suite_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "suite_commit_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["matches_local_head_at_freeze", "asset_bindings_are_live_byte_hashes", "clean_worktree_or_git_object_replay_proven"],
      "properties": {
        "matches_local_head_at_freeze": {"const": true},
        "asset_bindings_are_live_byte_hashes": {"const": true},
        "clean_worktree_or_git_object_replay_proven": {"const": false}
      }
    },
    "content_class": {"const": "repository-owned synthetic matched controls"},
    "created_without_dispatch": {"const": true},
    "asset_bindings": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asset_binding"}
    },
    "execution": {"$ref": "#/$defs/execution"},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "content_conditions",
        "guidance_conditions",
        "replicates_per_cell",
        "subject_call_cells",
        "fresh_context_per_cell"
      ],
      "properties": {
        "scenarios": {"const": 8},
        "content_conditions": {"const": ["benign", "injected"]},
        "guidance_conditions": {"const": ["ars_guided", "platform_only"]},
        "replicates_per_cell": {"const": 2},
        "subject_call_cells": {"const": 64},
        "fresh_context_per_cell": {"const": true}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed", "scenario_blocks", "cell_ids", "order_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-factorial-counterbalance-v1"},
        "seed": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
        "scenario_blocks": {"const": 8},
        "cell_ids": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/cell_id"}
        },
        "order_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cells": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/cell"}
    },
    "stop_rules": {
      "const": [
        "prompt_or_plan_hash_mismatch",
        "provider_auth_model_drift",
        "enabled_tool_or_web",
        "authorization_record_missing_or_mismatch",
        "blocked_or_partial_call",
        "unplanned_tool_action",
        "unplanned_network_action",
        "evidence_write_failure",
        "out_of_order_ingestion",
        "transcript_contract_failure",
        "blind_mapping_or_prior_label_leak"
      ]
    },
    "judge_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_independent_arm_blind_human_judges",
        "separate_arm_blind_human_adjudicator_required",
        "one_packet_per_judge_assignment",
        "raw_labels_must_be_retained",
        "human_evidence_may_not_be_fabricated",
        "packets_contain_no_labels"
      ],
      "properties": {
        "minimum_independent_arm_blind_human_judges": {"const": 2},
        "separate_arm_blind_human_adjudicator_required": {"const": true},
        "one_packet_per_judge_assignment": {"const": true},
        "raw_labels_must_be_retained": {"const": true},
        "human_evidence_may_not_be_fabricated": {"const": true},
        "packets_contain_no_labels": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cell_id": {"type": "string", "pattern": "^cell-[0-9]{3}$"},
    "asset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_provider",
        "subject_model",
        "subject_runtime",
        "subject_runtime_version",
        "auth_mode",
        "reasoning_effort",
        "input_token_cap",
        "output_token_cap",
        "tools",
        "web_enabled",
        "runner_transport",
        "dispatch_available",
        "api_spend_ceiling_usd",
        "api_fallback",
        "envelope_grants_consent",
        "fresh_external_authorization_required",
        "token_caps_enforced_by_runner",
        "observed_token_usage_required"
      ],
      "properties": {
        "subject_provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject_model": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject_runtime": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject_runtime_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "auth_mode": {"type": "string", "minLength": 1, "maxLength": 128},
        "reasoning_effort": {"type": "string", "minLength": 1, "maxLength": 64},
        "input_token_cap": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "output_token_cap": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "tools": {"const": []},
        "web_enabled": {"const": false},
        "runner_transport": {"const": "none"},
        "dispatch_available": {"const": false},
        "api_spend_ceiling_usd": {"const": 0},
        "api_fallback": {"const": false},
        "envelope_grants_consent": {"const": false},
        "fresh_external_authorization_required": {"const": true},
        "token_caps_enforced_by_runner": {"const": true},
        "observed_token_usage_required": {"const": true}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "sequence_index",
        "scenario_id",
        "content_condition",
        "guidance_condition",
        "replicate",
        "counterbalance_block_id",
        "scenario_sha256",
        "prompt_path",
        "prompt_sha256",
        "call_envelope_path",
        "call_envelope_sha256",
        "fresh_context_required"
      ],
      "properties": {
        "cell_id": {"$ref": "#/$defs/cell_id"},
        "sequence_index": {"type": "integer", "minimum": 1, "maximum": 64},
        "scenario_id": {"type": "string", "pattern": "^ipi-(web|pdf|bib|review)-(en|zh)$"},
        "content_condition": {"enum": ["benign", "injected"]},
        "guidance_condition": {"enum": ["ars_guided", "platform_only"]},
        "replicate": {"enum": [1, 2]},
        "counterbalance_block_id": {"type": "string", "pattern": "^scenario-block-[0-9]{2}-r[12]$"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_path": {"type": "string", "pattern": "^materials/prompts/cell-[0-9]{3}\\.txt$"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "call_envelope_path": {"type": "string", "pattern": "^materials/call-envelopes/cell-[0-9]{3}\\.json$"},
        "call_envelope_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_context_required": {"const": true}
      }
    }
  }
}
