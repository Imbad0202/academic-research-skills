{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/heldout/claim_standing_probe/expert_label.schema.json",
  "title": "#655 one blinded expert's label file",
  "description": "One domain-qualified human expert's independent labels over the seed set, produced from the blinded expert packet (claim + candidate only; no design_target, no subject output, no other expert's labels). Raw labels are retained verbatim; adjudication happens in a separate artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "expert_id",
    "blinded_to",
    "labels"
  ],
  "properties": {
    "schema_version": {
      "const": "claim-standing-expert-label/0.1"
    },
    "suite": {
      "const": "claim_standing_probe"
    },
    "expert_id": {
      "type": "string",
      "pattern": "^expert-[a-z0-9][a-z0-9-]{0,30}$"
    },
    "blinded_to": {
      "const": [
        "design_target",
        "subject_output",
        "other_expert_labels",
        "model_or_provider",
        "expected_baseline_performance"
      ]
    },
    "labels": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label"
      }
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "relevance",
        "check_state",
        "stance",
        "failure_state",
        "evidence_scope",
        "rationale",
        "label_guide_criterion"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^csp-(en|zh)-[a-z]+-[0-9]$"
        },
        "relevance": {
          "enum": [
            "relevant",
            "not_relevant"
          ]
        },
        "check_state": {
          "enum": [
            "performed",
            "not_checked"
          ]
        },
        "stance": {
          "anyOf": [
            {
              "enum": [
                "support",
                "contradict",
                "mixed",
                "not_addressed",
                "INSUFFICIENT_EVIDENCE",
                "AMBIGUOUS"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_state": {
          "anyOf": [
            {
              "enum": [
                "abstract_missing",
                "source_missing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_scope": {
          "enum": [
            "abstract",
            "session_held_full_text",
            "metadata_only"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200
        },
        "label_guide_criterion": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "check_state": {
                "const": "performed"
              }
            }
          },
          "then": {
            "properties": {
              "stance": {
                "type": "string"
              },
              "failure_state": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "check_state": {
                "const": "not_checked"
              }
            }
          },
          "then": {
            "properties": {
              "stance": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relevance": {
                "const": "relevant"
              },
              "check_state": {
                "const": "not_checked"
              }
            }
          },
          "then": {
            "properties": {
              "failure_state": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relevance": {
                "const": "not_relevant"
              }
            }
          },
          "then": {
            "properties": {
              "check_state": {
                "const": "not_checked"
              },
              "stance": {
                "const": null
              },
              "failure_state": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
