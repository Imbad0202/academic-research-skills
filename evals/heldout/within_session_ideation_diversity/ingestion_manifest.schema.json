{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/heldout/within_session_ideation_diversity/ingestion_manifest.schema.json",
  "title": "#659 append-only transcript ingestion state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "run_plan_sha256",
    "authorization_record_path",
    "authorization_record_sha256",
    "blind_manifest_ref",
    "blind_manifest_sha256",
    "status",
    "next_sequence_index",
    "stopped",
    "stop_receipt",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": "ideation-diversity-ingestion-manifest/1.0"},
    "suite": {"const": "within_session_ideation_diversity"},
    "run_plan_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_record_path": {
      "oneOf": [
        {"type": "null"},
        {"const": "authorization/record.json"}
      ]
    },
    "authorization_record_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "blind_manifest_ref": {
      "oneOf": [
        {"type": "null"},
        {"const": "blind/manifest.json"}
      ]
    },
    "blind_manifest_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "status": {"enum": ["initialized", "materialized", "ingesting", "complete", "blind_finalized", "stopped"]},
    "next_sequence_index": {"type": "integer", "minimum": 1, "maximum": 49},
    "stopped": {"type": "boolean"},
    "stop_receipt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/stop_receipt"}
      ]
    },
    "cells": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {"$ref": "#/$defs/cell_state"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "nullable_path": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(?:transcripts|blocked|receipts)/[A-Za-z0-9._/-]+$"}
      ]
    },
    "cell_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "sequence_index",
        "status",
        "transcript_ref",
        "transcript_sha256",
        "ingestion_receipt_ref"
      ],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^cell-[0-9]{3}$"},
        "sequence_index": {"type": "integer", "minimum": 1, "maximum": 48},
        "status": {"enum": ["pending", "ingested", "blocked"]},
        "transcript_ref": {"$ref": "#/$defs/nullable_path"},
        "transcript_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "ingestion_receipt_ref": {"$ref": "#/$defs/nullable_path"}
      }
    },
    "stop_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "sequence_index", "reason_code", "detail", "raw_ref", "raw_sha256", "raw_capture_kind", "retry_forbidden", "stop_intent_ref", "stop_intent_committed_before_state_replacement", "stop_intent_publication_staging_ref", "manifest_replacement_staging_ref", "pre_stop_inventory", "preserved_auxiliary_artifacts"],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^cell-[0-9]{3}$"},
        "sequence_index": {"type": "integer", "minimum": 1, "maximum": 48},
        "reason_code": {
          "enum": [
            "prompt_or_role_card_hash_mismatch",
            "arm_leakage",
            "ineligible_session",
            "authorization_record_missing_or_mismatch",
            "unplanned_tool_action",
            "unplanned_network_action",
            "evidence_write_failure",
            "partial_subject_output",
            "actor_protocol_deviation",
            "out_of_order_ingestion",
            "transcript_contract_failure"
          ]
        },
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "raw_ref": {"type": "string", "pattern": "^blocked/cell-[0-9]{3}\\.transcript\\.[0-9a-f]{64}\\.raw(?:\\.collision-[0-9a-f]{16})?$"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_capture_kind": {"enum": ["exact_input_bytes", "bounded_acquisition_failure_record"]},
        "retry_forbidden": {"const": true},
        "stop_intent_ref": {"const": "stop-intent.json"},
        "stop_intent_committed_before_state_replacement": {"const": true},
        "stop_intent_publication_staging_ref": {
          "type": "string",
          "pattern": "^\\.stop-intent\\.json\\.publish-[0-9a-f]{24}\\.tmp$"
        },
        "manifest_replacement_staging_ref": {
          "type": "string",
          "pattern": "^\\.ingestion-manifest\\.json\\.stop-[0-9a-f]{24}\\.json$"
        },
        "pre_stop_inventory": {"$ref": "#/$defs/inventory_binding"},
        "preserved_auxiliary_artifacts": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/preserved_auxiliary_artifact"}
        }
      }
    },
    "preserved_auxiliary_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "authorization_record",
            "accepted_transcript_before_state_commit",
            "ingestion_receipt_before_state_commit"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!run-plan\\.json$)(?!ingestion-manifest\\.json$)(?!stop-intent\\.json$)[^\\u0000]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inventory_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "sha256"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
