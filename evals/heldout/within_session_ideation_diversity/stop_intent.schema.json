{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/heldout/within_session_ideation_diversity/stop_intent.schema.json",
  "title": "#659 durable write-once irreversible stop intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "run_plan_sha256",
    "prior_manifest_sha256",
    "cell_id",
    "sequence_index",
    "reason_code",
    "detail",
    "raw_ref",
    "raw_sha256",
    "raw_capture_kind",
    "raw_base64",
    "stopped_manifest_sha256",
    "stopped_manifest_base64",
    "pre_stop_inventory",
    "stop_intent_publication_staging_ref",
    "manifest_replacement_staging_ref",
    "retry_forbidden"
  ],
  "properties": {
    "schema_version": {"const": "ideation-diversity-stop-intent/1.0"},
    "suite": {"const": "within_session_ideation_diversity"},
    "run_plan_sha256": {"$ref": "#/$defs/sha256"},
    "prior_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "cell_id": {"type": "string", "pattern": "^cell-[0-9]{3}$"},
    "sequence_index": {"type": "integer", "minimum": 1, "maximum": 48},
    "reason_code": {
      "enum": [
        "prompt_or_role_card_hash_mismatch",
        "arm_leakage",
        "ineligible_session",
        "authorization_record_missing_or_mismatch",
        "unplanned_tool_action",
        "unplanned_network_action",
        "evidence_write_failure",
        "partial_subject_output",
        "actor_protocol_deviation",
        "out_of_order_ingestion",
        "transcript_contract_failure"
      ]
    },
    "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
    "raw_ref": {
      "type": "string",
      "pattern": "^blocked/cell-[0-9]{3}\\.transcript\\.[0-9a-f]{64}\\.raw(?:\\.collision-[0-9a-f]{16})?$"
    },
    "raw_sha256": {"$ref": "#/$defs/sha256"},
    "raw_capture_kind": {"enum": ["exact_input_bytes", "bounded_acquisition_failure_record"]},
    "raw_base64": {"type": "string", "maxLength": 5592408},
    "stopped_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "stopped_manifest_base64": {"type": "string", "minLength": 1, "maxLength": 200000},
    "pre_stop_inventory": {"$ref": "#/$defs/inventory_binding"},
    "stop_intent_publication_staging_ref": {
      "type": "string",
      "pattern": "^\\.stop-intent\\.json\\.publish-[0-9a-f]{24}\\.tmp$"
    },
    "manifest_replacement_staging_ref": {
      "type": "string",
      "pattern": "^\\.ingestion-manifest\\.json\\.stop-[0-9a-f]{24}\\.json$"
    },
    "retry_forbidden": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "sha256"],
      "properties": {
        "entry_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
