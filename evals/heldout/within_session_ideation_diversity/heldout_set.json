      "role_brief": "You are a first-year education graduate student exploring classroom AI. You have observations from tutoring sessions but no fixed question, deadline, manuscript, or preferred method. The three framings below are yours before the dialogue begins.",
      "initial_message": "I keep noticing that students use the same AI tutor in very different ways, and I am not sure what question I actually want to ask about that yet.",
      "owned_framings": [
        {
          "framing_key": "F1",
          "facet_kind": "implementation_perspective",
          "statement": "The inquiry could distinguish how students actually use the tutor rather than treating access as one uniform intervention.",
          "initially_expressed": true,
          "matching_facet_phrases": [
            "the implementation perspective",
            "the use-pattern angle"
          ]
        },
        {
          "framing_key": "F2",
          "facet_kind": "stakeholder_perspective",
          "statement": "Teacher decisions about when and how the tutor enters class may define a separate perspective worth examining.",
          "initially_expressed": false,
          "matching_facet_phrases": [
            "the teacher perspective",
            "the instructor point of view"
          ]
        },
        {
          "framing_key": "F3",
          "facet_kind": "access_dimension",
          "statement": "Differences in device access and available study time may bound which students can use the tutor in the first place.",
          "initially_expressed": false,
          "matching_facet_phrases": [
            "the access dimension",
            "the resource-access angle"
          ]
