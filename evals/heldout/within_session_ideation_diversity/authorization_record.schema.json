{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ars://evals/heldout/within_session_ideation_diversity/authorization_record.schema.json",
  "title": "#659 exact-run external authorization record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "record_id",
    "run_plan_sha256",
    "run_id",
    "suite_commit",
    "suite_commit_provenance",
    "execution",
    "scope",
    "decision",
    "proof_boundary"
  ],
  "properties": {
    "schema_version": {"const": "ideation-diversity-authorization-record/1.0"},
    "suite": {"const": "within_session_ideation_diversity"},
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
    },
    "run_plan_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "suite_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "suite_commit_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified_by_no_call_runner", "verifiable_authority"],
      "properties": {
        "status": {"const": "operator_declared_unverified"},
        "verified_by_no_call_runner": {"const": false},
        "verifiable_authority": {"const": "run_plan_sha256_and_asset_bindings"}
      }
    },
    "execution": {"$ref": "#/$defs/execution"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type",
        "subject_session_cells",
        "cell_ids",
        "order_sha256"
      ],
      "properties": {
        "scope_type": {"const": "exact_run_plan_all_cells"},
        "subject_session_cells": {"const": 48},
        "cell_ids": {
          "type": "array",
          "minItems": 48,
          "maxItems": 48,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^cell-[0-9]{3}$"}
        },
        "order_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decided_at", "operator_reference", "statement"],
      "properties": {
        "status": {"enum": ["authorized", "denied", "revoked"]},
        "decided_at": {"type": "string", "format": "date-time"},
        "operator_reference": {"type": "string", "minLength": 8, "maxLength": 256, "pattern": "\\S"},
        "statement": {"type": "string", "minLength": 20, "maxLength": 2000, "pattern": "\\S"}
      }
    },
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_and_byte_binding_only",
        "operator_identity_verified_by_runner",
        "fresh_external_authorization_is_procedural_responsibility",
        "not_human_or_research_evidence"
      ],
      "properties": {
        "structural_and_byte_binding_only": {"const": true},
        "operator_identity_verified_by_runner": {"const": false},
        "fresh_external_authorization_is_procedural_responsibility": {"const": true},
        "not_human_or_research_evidence": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_provider",
        "subject_model",
        "subject_runtime",
        "subject_runtime_version",
        "auth_mode",
        "reasoning_effort",
        "input_token_cap",
        "output_token_cap",
        "token_cap_verification",
        "tools",
        "web_enabled",
        "runner_transport",
        "dispatch_available",
        "api_spend_ceiling_usd",
        "api_fallback",
        "envelope_grants_consent",
        "fresh_external_authorization_required"
      ],
      "properties": {
        "subject_provider": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "subject_model": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "subject_runtime": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "subject_runtime_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "auth_mode": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "reasoning_effort": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S"},
        "input_token_cap": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "output_token_cap": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "token_cap_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "enforced_by_no_call_runner", "observed_usage_recorded", "provider_tokenizer_verified"],
          "properties": {
            "status": {"const": "operator_declared_unverified"},
            "enforced_by_no_call_runner": {"const": false},
            "observed_usage_recorded": {"const": false},
            "provider_tokenizer_verified": {"const": false}
          }
        },
        "tools": {"const": []},
        "web_enabled": {"const": false},
        "runner_transport": {"const": "none"},
        "dispatch_available": {"const": false},
        "api_spend_ceiling_usd": {"const": 0},
        "api_fallback": {"const": false},
        "envelope_grants_consent": {"const": false},
        "fresh_external_authorization_required": {"const": true}
      }
    }
  }
}
