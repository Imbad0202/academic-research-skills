{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Imbad0202/academic-research-skills/shared/contracts/evidence/evidence_row_v1_3.schema.json",
 "title": "ARS Shared Evidence Row v1.3 — claim-standing advisory surface",
 "description": "Closed shared evidence-row carrier owned by #656, claim_standing_advisory surface (#655 design §5.2). One row per (probe claim, selected work-family candidate) carrying the bounded inspected-evidence excerpt and its exact source hash/span binding. The row expresses provenance and availability only: it never carries a stance, a support verdict, or a score, and an exact excerpt match never determines stance. Abstract-level evidence is declared as such and is never called verified full text. Rendering is inert; rows never touch the read ledger.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "surface",
  "row_id",
  "claim",
  "candidate",
  "coverage",
  "source",
  "excerpt",
  "cache",
  "content_handling",
  "row_sha256"
 ],
 "properties": {
  "schema_version": {
   "const": "evidence-row/1.3"
  },
  "surface": {
   "const": "claim_standing_advisory"
  },
  "row_id": {
   "type": "string",
   "pattern": "^EVR-CS-[A-Za-z0-9._:-]+(?![\\s\\S])",
   "maxLength": 200
  },
  "claim": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "claim_id",
    "claim_sha256",
    "probe_id"
   ],
   "properties": {
    "claim_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "claim_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "probe_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    }
   }
  },
  "candidate": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "work_family_id",
    "canonical_raw_hit_id",
    "candidate_ledger_sha256",
    "display_label",
    "doi"
   ],
   "properties": {
    "work_family_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "canonical_raw_hit_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "candidate_ledger_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "display_label": {
     "type": [
      "string",
      "null"
     ],
     "minLength": 1,
     "maxLength": 500
    },
    "doi": {
     "type": [
      "string",
      "null"
     ],
     "minLength": 1,
     "maxLength": 300
    }
   }
  },
  "coverage": {
   "enum": [
    "abstract",
    "session_held_full_text",
    "metadata_only"
   ],
   "description": "What the inspected evidence actually is. abstract never renders as, upgrades to, or is described as verified full text."
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_content_sha256",
    "source_content_utf8_bytes"
   ],
   "properties": {
    "source_content_sha256": {
     "oneOf": [
      {
       "$ref": "#/$defs/sha256"
      },
      {
       "type": "null"
      }
     ],
     "description": "SHA-256 of the exact inspected evidence text (the retained abstract or the consented session-held bounded passage). Null only when coverage is metadata_only."
    },
    "source_content_utf8_bytes": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   }
  },
  "excerpt": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "state",
    "text",
    "excerpt_sha256",
    "source_span_utf8",
    "captured_at"
   ],
   "properties": {
    "state": {
     "enum": [
      "verified_exact_match",
      "agent_extracted",
      "not_checked",
      "source_missing",
      "access_failed",
      "retrieval_failed"
     ],
     "description": "The family's canonical provenance/availability vocabulary, minus the two anchor-derived states (this surface carries no anchor). It never expresses whether the claim is supported."
    },
    "text": {
     "type": [
      "string",
      "null"
     ],
     "minLength": 1,
     "maxLength": 1000,
     "description": "At most 25 words by Python whitespace split, additionally bounded to 1000 Unicode code points. Non-null only for verified_exact_match or agent_extracted."
    },
    "excerpt_sha256": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
     "minLength": 64,
     "maxLength": 64
    },
    "source_span_utf8": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "start",
        "end"
       ],
       "properties": {
        "start": {
         "type": "integer",
         "minimum": 0
        },
        "end": {
         "type": "integer",
         "minimum": 1
        }
       }
      },
      {
       "type": "null"
      }
     ],
     "description": "Zero-based, end-exclusive byte offsets in source_content_sha256's exact UTF-8 byte stream."
    },
    "captured_at": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
     "description": "Original extraction timestamp. Cache replay preserves it instead of refreshing it."
    }
   }
  },
  "cache": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status",
    "key_sha256"
   ],
   "properties": {
    "status": {
     "enum": [
      "not_used",
      "miss",
      "hit"
     ]
    },
    "key_sha256": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
     "minLength": 64,
     "maxLength": 64
    }
   }
  },
  "content_handling": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "contains_external_text",
    "sharing_scope",
    "rights_basis"
   ],
   "properties": {
    "contains_external_text": {
     "type": "boolean",
     "description": "True when the row persists an excerpt or a decoded quote anchor. This is derived, not a rights judgment."
    },
    "sharing_scope": {
     "enum": [
      "session_only",
      "user_confirmed_shareable"
     ]
    },
    "rights_basis": {
     "enum": [
      "not_assessed",
      "user_declared_authorized"
     ]
    }
   },
   "description": "External-text rows default to session_only/not_assessed. The 25-word ceiling is data minimization, not a licence or fair-use determination."
  },
  "row_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
   "minLength": 64,
   "maxLength": 64,
   "description": "Unkeyed SHA-256 integrity checksum of the runtime's canonical JSON serialization of the complete row excluding only row_sha256 itself. It is not a signature or independent provenance proof; source-bound rows require explicit source replay before rendering."
  }
 },
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
   "minLength": 64,
   "maxLength": 64
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "content_handling": {
      "properties": {
       "sharing_scope": {
        "const": "user_confirmed_shareable"
       }
      },
      "required": [
       "sharing_scope"
      ]
     }
    },
    "required": [
     "content_handling"
    ]
   },
   "then": {
    "properties": {
     "content_handling": {
      "properties": {
       "rights_basis": {
        "const": "user_declared_authorized"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "content_handling": {
      "properties": {
       "rights_basis": {
        "const": "user_declared_authorized"
       }
      },
      "required": [
       "rights_basis"
      ]
     }
    },
    "required": [
     "content_handling"
    ]
   },
   "then": {
    "properties": {
     "content_handling": {
      "properties": {
       "sharing_scope": {
        "const": "user_confirmed_shareable"
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "excerpt": {
      "properties": {
       "state": {
        "enum": [
         "verified_exact_match",
         "agent_extracted"
        ]
       }
      },
      "required": [
       "state"
      ]
     }
    },
    "required": [
     "excerpt"
    ]
   },
   "then": {
    "properties": {
     "source": {
      "properties": {
       "source_content_sha256": {
        "type": "string"
       },
       "source_content_utf8_bytes": {
        "type": "integer"
       }
      }
     },
     "excerpt": {
      "properties": {
       "text": {
        "type": "string",
        "minLength": 1
       },
       "excerpt_sha256": {
        "type": "string"
       },
       "source_span_utf8": {
        "type": "object"
       },
       "captured_at": {
        "type": "string",
        "format": "date-time"
       }
      }
     },
     "cache": {
      "properties": {
       "status": {
        "enum": [
         "miss",
         "hit"
        ]
       },
       "key_sha256": {
        "type": "string"
       }
      }
     },
     "content_handling": {
      "properties": {
       "contains_external_text": {
        "const": true
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "excerpt": {
      "properties": {
       "state": {
        "enum": [
         "not_checked",
         "source_missing",
         "access_failed",
         "retrieval_failed"
        ]
       }
      },
      "required": [
       "state"
      ]
     }
    },
    "required": [
     "excerpt"
    ]
   },
   "then": {
    "properties": {
     "source": {
      "properties": {
       "source_content_sha256": {
        "type": "null"
       },
       "source_content_utf8_bytes": {
        "type": "null"
       }
      }
     },
     "excerpt": {
      "properties": {
       "text": {
        "type": "null"
       },
       "excerpt_sha256": {
        "type": "null"
       },
       "source_span_utf8": {
        "type": "null"
       },
       "captured_at": {
        "type": "null"
       }
      }
     },
     "cache": {
      "properties": {
       "status": {
        "const": "not_used"
       },
       "key_sha256": {
        "type": "null"
       }
      }
     },
     "content_handling": {
      "properties": {
       "contains_external_text": {
        "const": false
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "coverage": {
      "const": "metadata_only"
     }
    },
    "required": [
     "coverage"
    ]
   },
   "then": {
    "properties": {
     "excerpt": {
      "properties": {
       "state": {
        "enum": [
         "not_checked",
         "source_missing",
         "access_failed",
         "retrieval_failed"
        ]
       }
      }
     },
     "source": {
      "properties": {
       "source_content_sha256": {
        "type": "null"
       }
      }
     }
    }
   }
  }
 ]
}
