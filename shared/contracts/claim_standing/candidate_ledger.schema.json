{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Imbad0202/academic-research-skills/shared/contracts/claim_standing/candidate_ledger.schema.json",
  "title": "ARS Claim-standing Candidate Ledger v1",
  "description": "Closed replayable #655 Track A ledger. It retains every already-returned raw hit, explicit failed attempt, duplicate relation, relevance input, deterministic family, cull state, and cap overflow. It performs no retrieval or stance classification and carries no credibility, consensus, support, contradiction, gate, or efficacy result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "query_plan_sha256",
    "claim_sha256",
    "adapter_registry_sha256",
    "local_persistence",
    "export_boundary",
    "authorized_output_path",
    "retrieval_input_sha256",
    "attempts",
    "retry_authorizations",
    "raw_hits",
    "researcher_confirmed_version_relations",
    "work_families",
    "counts",
    "completed_at",
    "candidate_ledger_sha256"
  ],
  "properties": {
    "schema_version": { "const": "claim-standing-candidate-ledger/1.0" },
    "probe_id": { "$ref": "#/$defs/identifier" },
    "query_plan_sha256": { "$ref": "#/$defs/sha256" },
    "claim_sha256": { "$ref": "#/$defs/sha256" },
    "adapter_registry_sha256": { "$ref": "#/$defs/sha256" },
    "local_persistence": {
      "description": "Exact persistence authority copied from the hash-bound query-plan consent receipt.",
      "enum": ["session_only", "explicit_local_export"]
    },
    "export_boundary": {
      "description": "Exact export-boundary disclosure copied from the hash-bound consent receipt; runtime validation requires visible semantic NFKC text and rejects any surrogate.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "authorized_output_path": {
      "description": "Exact absolute operator-named CLI output path copied from the hash-bound consent receipt; null for session_only.",
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "retrieval_input_sha256": { "$ref": "#/$defs/sha256" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "retry_authorizations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/retry_authorization" }
    },
    "raw_hits": {
      "type": "array",
      "maxItems": 240,
      "items": { "$ref": "#/$defs/final_raw_hit" }
    },
    "researcher_confirmed_version_relations": {
      "type": "array",
      "maxItems": 240,
      "items": { "$ref": "#/$defs/confirmed_relation" }
    },
    "work_families": {
      "type": "array",
      "maxItems": 240,
      "items": { "$ref": "#/$defs/work_family" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "completed_at": { "$ref": "#/$defs/rfc3339" },
    "candidate_ledger_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "local_persistence": { "const": "explicit_local_export" }
        },
        "required": ["local_persistence"]
      },
      "then": {
        "properties": {
          "export_boundary": {
            "const": "One local candidate-ledger export to the operator-named output path is authorized."
          },
          "authorized_output_path": { "type": "string", "pattern": "\\S" }
        }
      },
      "else": {
        "properties": {
          "authorized_output_path": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "given"],
      "properties": {
        "family": {
          "description": "Portable schema uses \\S; runtime requires NFKC text with a visible letter or number and rejects any surrogate.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "given": {
          "description": "Portable schema uses \\S; runtime requires NFKC text with a visible letter or number and rejects any surrogate.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "query_id",
        "index_id",
        "started_at",
        "completed_at",
        "outcome",
        "provider_reported_count",
        "returned_count",
        "retained_hit_count",
        "truncated_count",
        "retry_of_attempt_id",
        "retry_authorization_receipt_id",
        "consent_receipt_id"
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/identifier" },
        "query_id": { "$ref": "#/$defs/identifier" },
        "index_id": { "$ref": "#/$defs/identifier" },
        "started_at": { "$ref": "#/$defs/rfc3339" },
        "completed_at": { "$ref": "#/$defs/rfc3339" },
        "outcome": {
          "enum": [
            "success",
            "timeout",
            "authentication_failed",
            "rate_limited",
            "malformed_response",
            "service_unavailable",
            "unsupported_query"
          ]
        },
        "provider_reported_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "returned_count": { "type": "integer", "minimum": 0 },
        "retained_hit_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "truncated_count": { "type": "integer", "minimum": 0 },
        "retry_of_attempt_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "retry_authorization_receipt_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "consent_receipt_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "retry_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_authorization_receipt_id",
        "query_plan_sha256",
        "probe_id",
        "consent_receipt_id",
        "failed_attempt_id",
        "query_id",
        "index_id",
        "accepted_at",
        "receipt_sha256"
      ],
      "properties": {
        "retry_authorization_receipt_id": { "$ref": "#/$defs/identifier" },
        "query_plan_sha256": { "$ref": "#/$defs/sha256" },
        "probe_id": { "$ref": "#/$defs/identifier" },
        "consent_receipt_id": { "$ref": "#/$defs/identifier" },
        "failed_attempt_id": { "$ref": "#/$defs/identifier" },
        "query_id": { "$ref": "#/$defs/identifier" },
        "index_id": { "$ref": "#/$defs/identifier" },
        "accepted_at": { "$ref": "#/$defs/rfc3339" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "base_raw_hit": {
      "type": "object",
      "required": [
        "raw_hit_id",
        "probe_id",
        "query_id",
        "index_id",
        "attempt_id",
        "provider_rank",
        "provider_record_id",
        "doi",
        "title",
        "authors",
        "year",
        "language",
        "document_type",
        "publication_status",
        "abstract_state",
        "abstract_text",
        "abstract_sha256",
        "landing_url",
        "returned_at",
        "raw_metadata_sha256",
        "explicit_version_of_raw_hit_id"
      ],
      "properties": {
        "raw_hit_id": { "$ref": "#/$defs/identifier" },
        "probe_id": { "$ref": "#/$defs/identifier" },
        "query_id": { "$ref": "#/$defs/identifier" },
        "index_id": { "$ref": "#/$defs/identifier" },
        "attempt_id": { "$ref": "#/$defs/identifier" },
        "provider_rank": { "type": "integer", "minimum": 1, "maximum": 20 },
        "provider_record_id": {
          "description": "Portable schema uses \\S; a non-null runtime identity requires NFKC text with a visible letter or number and rejects any surrogate.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "doi": {
          "description": "Retained provider text. Runtime identity accepts only an NFKC/prefix-trimmed 10.<4-9 digits>/<suffix> DOI whose suffix contains a letter or number and no Unicode C/Z/whitespace character; other strings remain visible raw metadata but are not stable identity.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "title": {
          "description": "Portable schema uses \\S; a non-null runtime title requires NFKC text with a visible letter, number, or symbol and rejects any surrogate.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "authors": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/author" }
        },
        "year": {
          "type": ["integer", "null"],
          "minimum": 1000,
          "maximum": 9999
        },
        "language": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 35
        },
        "document_type": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "publication_status": {
          "enum": ["published", "preprint", "other", "unknown"]
        },
        "abstract_state": { "enum": ["available", "missing", "not_returned"] },
        "abstract_text": {
          "description": "Portable schema uses \\S; an available abstract is runtime-checked after NFKC for a visible letter, number, or symbol and any surrogate is rejected.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "abstract_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "landing_url": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        },
        "returned_at": { "$ref": "#/$defs/rfc3339" },
        "raw_metadata_sha256": { "$ref": "#/$defs/sha256" },
        "explicit_version_of_raw_hit_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        }
      }
    },
    "final_raw_hit": {
      "allOf": [
        { "$ref": "#/$defs/base_raw_hit" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_hit_id",
            "probe_id",
            "query_id",
            "index_id",
            "attempt_id",
            "provider_rank",
            "provider_record_id",
            "doi",
            "title",
            "authors",
            "year",
            "language",
            "document_type",
            "publication_status",
            "abstract_state",
            "abstract_text",
            "abstract_sha256",
            "landing_url",
            "returned_at",
            "raw_metadata_sha256",
            "explicit_version_of_raw_hit_id",
            "terminal_state",
            "work_family_id",
            "retained_raw_hit_id"
          ],
          "properties": {
            "raw_hit_id": true,
            "probe_id": true,
            "query_id": true,
            "index_id": true,
            "attempt_id": true,
            "provider_rank": true,
            "provider_record_id": true,
            "doi": true,
            "title": true,
            "authors": true,
            "year": true,
            "language": true,
            "document_type": true,
            "publication_status": true,
            "abstract_state": true,
            "abstract_text": true,
            "abstract_sha256": true,
            "landing_url": true,
            "returned_at": true,
            "raw_metadata_sha256": true,
            "explicit_version_of_raw_hit_id": true,
            "terminal_state": {
              "enum": [
                "selected",
                "missing_title_and_stable_id",
                "outside_date_range",
                "outside_language_set",
                "outside_document_type",
                "duplicate_version",
                "not_relevant",
                "not_checked",
                "candidate_cap_exceeded"
              ]
            },
            "work_family_id": {
              "oneOf": [
                { "$ref": "#/$defs/identifier" },
                { "type": "null" }
              ]
            },
            "retained_raw_hit_id": {
              "oneOf": [
                { "$ref": "#/$defs/identifier" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "confirmed_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_raw_hit_id",
        "right_raw_hit_id",
        "confirmation_receipt_id"
      ],
      "properties": {
        "left_raw_hit_id": { "$ref": "#/$defs/identifier" },
        "right_raw_hit_id": { "$ref": "#/$defs/identifier" },
        "confirmation_receipt_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_raw_hit_id",
        "outcome",
        "state",
        "reason_code",
        "rationale",
        "assessor_kind",
        "assessor_id",
        "prompt_version",
        "assessment_input_sha256",
        "prompt_utf8",
        "prompt_sha256",
        "raw_output",
        "raw_output_sha256",
        "failure_code",
        "failure_detail",
        "assessed_at"
      ],
      "properties": {
        "canonical_raw_hit_id": { "$ref": "#/$defs/identifier" },
        "outcome": { "enum": ["success", "failed"] },
        "state": { "enum": ["relevant", "not_relevant", "ambiguous", "not_checked"] },
        "reason_code": {
          "type": ["string", "null"],
          "enum": [
            "population_mismatch",
            "phenomenon_or_exposure_mismatch",
            "outcome_mismatch",
            "proposition_mismatch",
            null
          ]
        },
        "rationale": {
          "description": "On success, runtime requires NFKC text with a visible letter, number, or symbol and rejects any surrogate.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "assessor_kind": { "enum": ["synthetic_fixture", "external_provided"] },
        "assessor_id": { "$ref": "#/$defs/identifier" },
        "prompt_version": { "$ref": "#/$defs/identifier" },
        "assessment_input_sha256": { "$ref": "#/$defs/sha256" },
        "prompt_utf8": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "raw_output": {
          "description": "On success, runtime requires visible semantic NFKC text and rejects any surrogate. Failed malformed output is retained exactly and may be whitespace-only or format-only, but still must be valid UTF-8 text.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 10000
        },
        "raw_output_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "failure_code": {
          "type": ["string", "null"],
          "enum": ["timeout", "malformed_output", "assessor_unavailable", "cancelled", null]
        },
        "failure_detail": {
          "description": "On failure, runtime requires NFKC text with a visible letter, number, or symbol and rejects any surrogate.",
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "assessed_at": { "$ref": "#/$defs/rfc3339" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "success" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "state": { "enum": ["relevant", "not_relevant", "ambiguous"] },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
              "raw_output": { "type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S" },
              "raw_output_sha256": { "$ref": "#/$defs/sha256" },
              "failure_code": { "type": "null" },
              "failure_detail": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "state": { "const": "not_checked" },
              "reason_code": { "type": "null" },
              "rationale": { "type": "null" },
              "failure_code": {
                "enum": ["timeout", "malformed_output", "assessor_unavailable", "cancelled"]
              },
              "failure_detail": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "not_relevant" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "population_mismatch",
                  "phenomenon_or_exposure_mismatch",
                  "outcome_mismatch",
                  "proposition_mismatch"
                ]
              }
            }
          },
          "else": { "properties": { "reason_code": { "type": "null" } } }
        },
        {
          "oneOf": [
            {
              "properties": {
                "raw_output": { "type": "string", "minLength": 1, "maxLength": 10000 },
                "raw_output_sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "properties": {
                "raw_output": { "type": "null" },
                "raw_output_sha256": { "type": "null" }
              }
            }
          ]
        }
      ]
    },
    "work_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_family_id",
        "member_raw_hit_ids",
        "canonical_raw_hit_id",
        "query_ids",
        "index_ids",
        "relevance",
        "selection_state",
        "coverage",
        "content_state",
        "content_sha256",
        "sharing_scope",
        "rights_basis"
      ],
      "properties": {
        "work_family_id": { "$ref": "#/$defs/identifier" },
        "member_raw_hit_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 240,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "canonical_raw_hit_id": { "$ref": "#/$defs/identifier" },
        "query_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "index_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "relevance": { "$ref": "#/$defs/relevance" },
        "selection_state": {
          "enum": ["selected", "not_relevant", "not_checked", "candidate_cap_exceeded"]
        },
        "coverage": { "enum": ["abstract", "metadata_only"] },
        "content_state": { "enum": ["available", "abstract_missing", "not_checked"] },
        "content_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "sharing_scope": {
          "description": "Persistence scope copied from the same consent receipt; runtime requires equality with root local_persistence.",
          "enum": ["session_only", "explicit_local_export"]
        },
        "rights_basis": { "const": "not_assessed" }
      }
    },
    "raw_hit_state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "missing_title_and_stable_id",
        "outside_date_range",
        "outside_language_set",
        "outside_document_type",
        "duplicate_version",
        "not_relevant",
        "not_checked",
        "candidate_cap_exceeded"
      ],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "missing_title_and_stable_id": { "type": "integer", "minimum": 0 },
        "outside_date_range": { "type": "integer", "minimum": 0 },
        "outside_language_set": { "type": "integer", "minimum": 0 },
        "outside_document_type": { "type": "integer", "minimum": 0 },
        "duplicate_version": { "type": "integer", "minimum": 0 },
        "not_relevant": { "type": "integer", "minimum": 0 },
        "not_checked": { "type": "integer", "minimum": 0 },
        "candidate_cap_exceeded": { "type": "integer", "minimum": 0 }
      }
    },
    "attempt_failure_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout",
        "authentication_failed",
        "rate_limited",
        "malformed_response",
        "service_unavailable",
        "unsupported_query"
      ],
      "properties": {
        "timeout": { "type": "integer", "minimum": 0 },
        "authentication_failed": { "type": "integer", "minimum": 0 },
        "rate_limited": { "type": "integer", "minimum": 0 },
        "malformed_response": { "type": "integer", "minimum": 0 },
        "service_unavailable": { "type": "integer", "minimum": 0 },
        "unsupported_query": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "successful_attempts",
        "failed_attempts",
        "raw_hits",
        "work_families",
        "selected_work_families",
        "raw_hit_state_counts",
        "attempt_failure_counts"
      ],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "successful_attempts": { "type": "integer", "minimum": 0 },
        "failed_attempts": { "type": "integer", "minimum": 0 },
        "raw_hits": { "type": "integer", "minimum": 0, "maximum": 240 },
        "work_families": { "type": "integer", "minimum": 0, "maximum": 240 },
        "selected_work_families": { "type": "integer", "minimum": 0, "maximum": 40 },
        "raw_hit_state_counts": { "$ref": "#/$defs/raw_hit_state_counts" },
        "attempt_failure_counts": { "$ref": "#/$defs/attempt_failure_counts" }
      }
    }
  }
}
