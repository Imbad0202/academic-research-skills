{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Imbad0202/academic-research-skills/shared/contracts/claim_standing/transmission_ledger.schema.json",
  "title": "#655 claim-standing transmission ledger v1",
  "description": "Closed per-event accounting of every authorized transmission attempt in one claim-standing probe (design §6): retrieval queries to consented scholarly indexes and stance-classification prompts to the consented stance provider. Each event records recipient, purpose, exact content classes, byte count, local hash, time, consent receipt, retention disclosure, and result state. Accounting is conservative: an attempt an adapter refused before transport still appears with its failure result state, so the ledger may overstate, never understate, what could have left the session; byte counts are of the consented content class (accepted query text / exact prompt), not transport framing. scripts/check_claim_standing_transmissions.py is the normative builder/validator; it refuses any event outside the plan's authorized content classes or consented recipient roster.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "query_plan_sha256",
    "consent_receipt_id",
    "consent_receipt_sha256",
    "authorized_content_classes",
    "events",
    "transmission_ledger_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "claim-standing-transmission-ledger/1.0"
    },
    "probe_id": {
      "$ref": "#/$defs/identifier"
    },
    "query_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "consent_receipt_id": {
      "$ref": "#/$defs/identifier"
    },
    "consent_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorized_content_classes": {
      "description": "Copied verbatim from the consented query plan; every event's content classes must be a subset.",
      "oneOf": [
        {
          "const": [
            "accepted_search_query"
          ]
        },
        {
          "const": [
            "accepted_search_query",
            "claim_and_selected_evidence_to_stance_provider"
          ]
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/retrieval_event"
          },
          {
            "$ref": "#/$defs/stance_event"
          }
        ]
      },
      "uniqueItems": true
    },
    "transmission_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "semantic_text": {
      "description": "Portable schema uses \\S; runtime additionally requires NFKC text with a visible letter, number, or symbol and rejects any surrogate.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "retrieval_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_kind",
        "attempt_id",
        "query_id",
        "recipient_index_id",
        "recipient_product_identity",
        "purpose",
        "content_classes",
        "query_sha256",
        "query_utf8_bytes",
        "consent_receipt_id",
        "retention_state",
        "retention_reference",
        "sent_at",
        "result_state"
      ],
      "properties": {
        "event_kind": {
          "const": "retrieval_query"
        },
        "attempt_id": {
          "$ref": "#/$defs/identifier"
        },
        "query_id": {
          "$ref": "#/$defs/identifier"
        },
        "recipient_index_id": {
          "$ref": "#/$defs/identifier"
        },
        "recipient_product_identity": {
          "$ref": "#/$defs/semantic_text"
        },
        "purpose": {
          "const": "scholarly_discovery"
        },
        "content_classes": {
          "const": [
            "accepted_search_query"
          ]
        },
        "query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "query_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "consent_receipt_id": {
          "$ref": "#/$defs/identifier"
        },
        "retention_state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "retention_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "sent_at": {
          "$ref": "#/$defs/rfc3339"
        },
        "result_state": {
          "enum": [
            "success",
            "timeout",
            "authentication_failed",
            "rate_limited",
            "malformed_response",
            "service_unavailable",
            "unsupported_query"
          ]
        }
      },
      "$ref": "#/$defs/retention_conditional"
    },
    "stance_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_kind",
        "work_family_id",
        "recipient_provider_identity",
        "recipient_model_identity",
        "purpose",
        "content_classes",
        "prompt_sha256",
        "prompt_utf8_bytes",
        "consent_receipt_id",
        "retention_state",
        "retention_reference",
        "sent_at",
        "result_state"
      ],
      "properties": {
        "event_kind": {
          "const": "stance_classification"
        },
        "work_family_id": {
          "$ref": "#/$defs/identifier"
        },
        "recipient_provider_identity": {
          "$ref": "#/$defs/semantic_text"
        },
        "recipient_model_identity": {
          "$ref": "#/$defs/semantic_text"
        },
        "purpose": {
          "const": "stance_classification"
        },
        "content_classes": {
          "const": [
            "claim_and_selected_evidence_to_stance_provider"
          ]
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "consent_receipt_id": {
          "$ref": "#/$defs/identifier"
        },
        "retention_state": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "retention_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000
        },
        "sent_at": {
          "$ref": "#/$defs/rfc3339"
        },
        "result_state": {
          "enum": [
            "performed",
            "judge_timeout",
            "judge_error",
            "oversized_output",
            "parse_error"
          ]
        }
      },
      "$ref": "#/$defs/retention_conditional"
    },
    "retention_conditional": {
      "if": {
        "properties": {
          "retention_state": {
            "const": "known"
          }
        },
        "required": [
          "retention_state"
        ]
      },
      "then": {
        "properties": {
          "retention_reference": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "retention_reference": {
            "type": "null"
          }
        }
      }
    }
  }
}
