    {
      "criterion_id": "official.msr2027.technical.full.open-science",
      "version": "2027-cfp.pane-sha256-2546217a5f2b7dccb3b617b976e75cf7427c9a3881fda3092323c94a35231795",
      "authority_class": "official_venue_type",
      "dimension": "submission_readiness",
      "title": "MSR 2027 data-availability and artifact disclosure",
      "statement": "Include a data-availability statement; disclose relevant source code, anonymized and curated study data, and reproduction or replication instructions when possible; identify and explain any ethical, legal, technical, economic, or other barrier to disclosure.",
