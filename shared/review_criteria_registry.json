    {
      "criterion_id": "field.sigsoft.empirical.general-essential",
      "version": "d131d7209f2fad7e8dfd30afbd2b8ea605ea3141",
      "authority_class": "field_society_standard",
      "dimension": "scientific_validity",
      "title": "ACM SIGSOFT General Standard essential attributes",
      "statement": "For a software-engineering study that collects and analyzes data, state and motivate its questions; name and justify the methodology; describe data collection and analysis; connect results and conclusions to the questions and evidence; disclose major limitations; and address applicable research risks and empirical standards.",
      "source": {
        "title": "ACM SIGSOFT Empirical Standards — General Standard",
        "publisher": "ACM SIGSOFT",
        "uri": "https://github.com/acmsigsoft/EmpiricalStandards/blob/d131d7209f2fad7e8dfd30afbd2b8ea605ea3141/docs/standards/GeneralStandard.md#L7-L75",
        "effective_date": "2025-02-19",
        "verified_at": "2026-08-24",
        "freshness": "current"
      },
      "applicability": {"disciplines": ["Software Engineering"], "subfields": [], "venues": [], "tracks": [], "contribution_types": [], "overlays": ["ACM SIGSOFT Repository Mining Standard"]},
